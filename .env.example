# ===================================================
# CareCircle — Environment Configuration
# ===================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session & JWT Secrets (Must be at least 32 characters in production)
JWT_SECRET=carecircle-super-secure-production-jwt-secret-key-32chars
SESSION_COOKIE_NAME=carecircle_session

# Database Configuration
# PostgreSQL connection string (defaults to local fallback storage if omitted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carecircle

# Email Dispatcher (Resend or SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareCircle Health <notifications@carecircle.health>
RESEND_API_KEY=

# Google Services Integration
# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Background Cron Secret Key (For adherence evaluator endpoint)
CRON_SECRET_KEY=carecircle-cron-evaluator-secret-key-2026

